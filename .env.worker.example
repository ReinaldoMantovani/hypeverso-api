# =============================================================================
# IA local (seu PC) → MySQL da Hostinger
# 1) hPanel › Bancos de dados › Remote MySQL: libere o IP do seu PC (ou "Qualquer host").
# 2) Use o "hostname do MySQL remoto" mostrado nessa mesma página.
# =============================================================================
DATABASE_URL=mysql://USUARIO:SENHA@HOST_REMOTO_DO_MYSQL:3306/NOME_DO_BANCO?connection_limit=3

# URL pública do site (as imagens geradas pela IA ficam em SITE/uploads/...)
PUBLIC_WEB_URL=https://seudominio.com.br

# Modelos do Ollama (baixados automaticamente na primeira vez)
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_FALLBACK_MODELS=qwen3:1.7b,qwen2.5:3b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Opcional: catálogo (TMDB) usado em alguns textos
TMDB_READ_TOKEN=
