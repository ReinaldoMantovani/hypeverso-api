# =============================================================================
# Hypeverso API — Hostinger Business (Node.js Web App)
# Cadastre estas variáveis em hPanel › Web App da API › Variáveis de ambiente.
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================
NODE_ENV=production

# MySQL da Hostinger (hPanel › Bancos de dados › MySQL). Dentro da Hostinger o host costuma ser "localhost".
# connection_limit baixo: o plano compartilhado limita conexões simultâneas.
DATABASE_URL=mysql://hypeverso:Hypeverso05@localhost:3306/hypeverso?connection_limit=5&pool_timeout=20

# URLs
PUBLIC_WEB_URL=https://hypeverso.com
ASSET_BASE_URL=https://hypeverso.com/uploads
# Site + CMS local (o CMS roda em http://localhost:3001 no seu PC)
CORS_ORIGIN=https://hypeverso.com,https://www.hypeverso.com,http://localhost:3001
# Mesmo valor no site (Hostinger) e no CMS (.env.local)
GATEWAY_SHARED_SECRET=TROQUE_32_ou_mais_caracteres

# Sessão e 2FA
JWT_ACCESS_SECRET=9d6df22d657ff5b4c6176087ed626405cae6801bafb6f85ab7779492de561957
JWT_REFRESH_SECRET=5e331d7e0c7a0bdef926311fa4a87c51580f83a33cc35f5781a7606129f0cdbb
MFA_ENCRYPTION_KEY=922e9eb61d2bb4d9a94b3b825c341f9aaea0c743d8f764be5b95d2887ccc3670
MFA_REQUIRED_FOR_STAFF=true
COOKIE_SECURE=true
ENABLE_SWAGGER=false
# A Hostinger fica atrás de 1 proxy: confiar só nesse salto evita IP falsificado em X-Forwarded-For.
TRUST_PROXY=1

# Sem Redis, sem Meilisearch, sem BullMQ (Business não oferece). Deixe vazio/false.
REDIS_URL=redis://:hypeverso-local-redis-password@redis:6379
MEILISEARCH_URL=http://meilisearch:7700
MEILI_ENV=development
MEILI_MASTER_KEY=nexverse-local-meili-master-key
MEILI_TIMEOUT_MS=10000
# BullMQ Community/Open Source — gratuito, self-hosted e usa o Redis do próprio Hypeverso.
BULLMQ_ENABLED=true
BULLMQ_PREFIX=nexverse
BULLMQ_AI_NEWS_ATTEMPTS=3
BULLMQ_BACKOFF_MS=5000
BULLMQ_SYSTEM_CONCURRENCY=5
BULLMQ_AI_CONCURRENCY=1
BULLMQ_DISCOVERY_CONCURRENCY=1
# A IA roda no seu PC (docker-compose.local-ai.yml ou npm run worker:local).
AI_NEWS_WORKER_ENABLED=false
IMAGE_MODERATION_ENABLED=false
# Sincroniza o banco durante o build (on | off | strict)
DB_SYNC=on

# Integrações opcionais
TMDB_READ_TOKEN=4e477968b18c62c8aeae651019e5237c
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hypeverso <no-reply@seudominio.com.br>
TURNSTILE_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@hypeverso.com
NEWSLETTER_ENABLED=true
NEWSLETTER_WEEKDAY=5
NEWSLETTER_HOUR_UTC=12
ADSENSE_ACCOUNT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
