{
  "name": "hypeverso-api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "API do Hypeverso (Fastify + Prisma/MySQL). Pronta para Node.js Web App da Hostinger (plano Business).",
  "scripts": {
    "build": "prisma generate && node scripts/db-sync.mjs && tsup",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "worker:ai": "tsx src/ai-worker.ts",
    "worker:discovery": "tsx src/discovery-worker.ts",
    "worker:local": "node scripts/local-workers.mjs",
    "test": "vitest run && node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js tests/security.jest.test.mjs",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "db:sync": "node scripts/db-sync.mjs",
    "backup": "docker compose -f docker-compose.local-ai.yml --env-file .env.worker run --rm -e ONCE=1 mysql-backup",
    "worker:shop": "tsx src/shop-worker.ts",
    "worker:moderation": "tsx src/moderation-worker.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "6.19.3",
    "@types/node": "^22.18.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.3.8",
    "cheerio": "^1.1.2",
    "fastify": "^5.12.5",
    "fastify-raw-body": "^6.0.1",
    "ioredis": "^5.7.0",
    "nanoid": "^5.1.5",
    "nodemailer": "^7.0.6",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.4",
    "stripe": "^18.5.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "web-push": "^3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/mysql": "^11.14.0",
    "@types/nodemailer": "^7.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "jest": "^30.1.3",
    "prettier": "^3.9.10",
    "testcontainers": "^11.14.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
