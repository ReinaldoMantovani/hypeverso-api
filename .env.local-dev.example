# Copie para ".env" para rodar a API no seu PC (npm run dev).
# MySQL local do docker-compose.dev.yml (porta 3307) — ou troque pelo host REMOTO da Hostinger.
DATABASE_URL=mysql://hypeverso:hypeverso@127.0.0.1:3307/hypeverso?connection_limit=5
NODE_ENV=development
API_PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
ASSET_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_ACCESS_SECRET=dev-access-secret-0123456789abcdef0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-0123456789abcdef0123456789
GATEWAY_SHARED_SECRET=troque-este-segredo-do-gateway-hypeverso-local
COOKIE_SECURE=false
MFA_REQUIRED_FOR_STAFF=false
REDIS_URL=
MEILISEARCH_URL=
